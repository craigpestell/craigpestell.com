{
  "extraKnownMarketplaces": {
    "company-kit": { "source": { "source": "github", "repo": "craigpestell/company-kit" } }
  },
  "enabledPlugins": {
    "company-skills@company-kit": true,
    "company-lite@company-kit": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -Eq 'git push.*(--force|-f( |$))' && { echo 'Force-push blocked' >&2; exit 2; } || exit 0"
          }
        ]
      }
    ]
  }
}
